/* 搜索 · 按书筛选 chips（跨两本指南） */
.book-filter { display: flex; gap: 14rpx; flex-wrap: wrap; padding: 20rpx 0 4rpx; }
.bf-chip {
  font-size: 23rpx;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E5E7E0;
  background: #FFFDF9;
  color: #6B778C;
}
.bf-chip.on {
  background: #E5EEE7;
  border-color: #226B60;
  color: #226B60;
  font-weight: 600;
}
