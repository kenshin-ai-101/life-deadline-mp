/* 我的清单 · 页面局部样式，全局样式见 app.wxss */

/* 分组视图切换 */
.view-switch { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 18rpx; }
.view-switch-hint { font-size: 23rpx; color: #8A94A6; }
.view-switch-btn { font-size: 24rpx; color: #226B60; background: #FFFDF9; border: 1rpx solid #E5E7E0; border-radius: 999rpx; padding: 8rpx 22rpx; }

/* 按事件分组 */
.group { background: #FFFDF9; border: 1rpx solid #E5E7E0; border-radius: 16rpx; margin-bottom: 24rpx; overflow: hidden; }
.group-head { display: flex; align-items: flex-start; padding: 24rpx 22rpx 20rpx; background: #EFEEE7; }
.group-badge {
  width: 64rpx; height: 64rpx; flex: 0 0 64rpx; box-sizing: border-box;
  border-radius: 14rpx; background: #E5EEE7; color: #226B60;
  box-shadow: inset 0 0 0 2rpx #226B60;
  font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.group-badge.urgent { background: #C0392B; color: #FFFFFF; }
.group-badge.plain { background: #EFEEE7; color: #69736D; }
.group-name { font-size: 30rpx; font-weight: 600; color: #226B60; }
.group-count { font-size: 23rpx; color: #8A94A6; }
.group-meta { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.group-fold { font-size: 23rpx; color: #226B60; margin-left: 12rpx; flex: 0 0 auto; padding-top: 6rpx; }
.group-body { padding: 20rpx 20rpx 4rpx; }
.group-body .todo-card { margin-bottom: 16rpx; border-left: 6rpx solid #E5E7E0; }
.group-body .todo-card.is-overdue { border-left-color: #C0392B; }
.group-foot { padding: 18rpx 22rpx; border-top: 1rpx solid #E5E7E0; text-align: right; }
