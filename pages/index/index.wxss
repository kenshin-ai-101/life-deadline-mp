.masthead { padding: 20rpx 4rpx 28rpx; }
.brand { font-size: 46rpx; font-weight: 600; color: #242E2B; letter-spacing: .04em; }
.tagline { display: block; margin-top: 10rpx; font-size: 25rpx; color: #6B778C; }

.aid-entry {
  display: flex; align-items: center;
  background: #C0392B; border-radius: 16rpx;
  padding: 32rpx 30rpx; margin: 8rpx 0 12rpx; color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(192,57,43,.18);
}
.aid-kicker { display: block; font-size: 21rpx; letter-spacing: .14em; opacity: .82; }
.aid-title { display: block; font-size: 40rpx; font-weight: 600; margin: 8rpx 0 6rpx; }
.aid-desc { display: block; font-size: 24rpx; opacity: .9; }
.aid-arrow { font-size: 56rpx; font-weight: 200; opacity: .8; margin-left: 16rpx; }

/* 两列网格：宽度略小于一半 + space-between 分配间距。
   不能用「50%-x 加 margin 恰好等于 100%」的写法——rpx→px 逐元素舍入后
   总和会超出容器零点几像素，卡片被挤到下一行（一行 1 卡、右侧留白）。 */
.event-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.event-cell {
  width: calc(50% - 10rpx); margin-bottom: 20rpx;
  background: #FFFDF9; border: 1rpx solid #E5E7E0; border-radius: 14rpx;
  padding: 22rpx 20rpx; box-sizing: border-box;
}
.event-badge {
  display: inline-flex; align-items: center; justify-content: center;
  width: 48rpx; height: 48rpx; border-radius: 10rpx;
  background: #E5EEE7; color: #226B60; font-size: 25rpx; font-weight: 600;
  margin-bottom: 14rpx;
}
.event-name { display: block; font-size: 29rpx; font-weight: 600; color: #1F2A37; }
.event-count { display: block; margin-top: 8rpx; font-size: 21rpx; color: #8A94A6; }

.timeline-card { padding: 24rpx 26rpx; }
.empty-inline { padding: 30rpx 26rpx; }

/* ---------- 今天想改善什么 ----------
   1:1 复刻《人生指南库》「为我推荐」tab 的 .pf + .qc：
   浅瓷绿 hero 底 #E5ECE6、右下插画、松石绿按钮，尺寸与字阶同 reco.wxss。 */
.hero-pf {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 22rpx; color: #69736D;
  margin: 32rpx 4rpx 16rpx;
}
.hero-pf-b { color: #226B60; font-weight: 600; }

.hero-qc {
  position: relative; overflow: hidden;
  min-height: 332rpx;
  padding: 42rpx 32rpx;
  margin: 8rpx 0 12rpx;
  border-radius: 24rpx;
  background: #E5ECE6;
  box-sizing: border-box;
}
.hero-qc-hover { opacity: .92; }
.hero-qm { position: relative; z-index: 2; max-width: 368rpx; }
.hero-qt {
  font-size: 38rpx; font-weight: 650; letter-spacing: -1rpx;
  white-space: nowrap; color: #242E2B;
}
.hero-qs {
  font-size: 22rpx; line-height: 1.8;
  max-width: 330rpx; margin-top: 16rpx; color: #69736D;
}
.hero-qa {
  display: inline-flex; align-items: center;
  margin-top: 32rpx; padding: 14rpx 24rpx;
  min-height: 64rpx; font-size: 22rpx;
  border-radius: 16rpx; color: #FFFFFF;
  background: #226B60; font-weight: 600;
}
.hero-illo {
  position: absolute; right: -10rpx; bottom: 6rpx;
  width: 308rpx; height: 316rpx; z-index: 1;
}

/* ---------- 最近更新 ----------
   1:1 复刻《人生指南库》「为我推荐」tab 的 .sech + .upd + .row；
   色值取 variables-v2.wxss：纸面 #FFFDF9、发丝线 #E5E7E0、
   正文 #242E2B、次级 #69736D、品牌 #226B60、陶土 #956947。 */
.ru-sech { display: flex; align-items: baseline; margin: 44rpx 4rpx 22rpx; }
.ru-t { font-size: 32rpx; font-weight: 650; color: #242E2B; }
.ru-n { font-size: 22rpx; color: #69736D; margin-left: 16rpx; }
.ru-more { margin-left: auto; font-size: 22rpx; color: #69736D; }
.ru-more-hover { opacity: .6; }

.ru-upd {
  background: #FFFDF9;
  border: 1rpx solid #E5E7E0;
  border-radius: 24rpx;
  padding: 0 24rpx;
}
.ru-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 26rpx 0; }
.ru-row + .ru-row { border-top: 1rpx solid #E5E7E0; }
.ru-row-hover { opacity: .75; }
.ru-dot { width: 8rpx; height: 44rpx; border-radius: 6rpx; flex: none; margin-top: 4rpx; }
.ru-rc { flex: 1; min-width: 0; }
.ru-l1 { display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; color: #69736D; }
.ru-tag { font-size: 22rpx; font-weight: 500; padding: 4rpx 12rpx; border-radius: 12rpx; }
.ru-tag-new { background: #E5EEE7; color: #226B60; }
.ru-tag-up { background: #F6EBDD; color: #956947; }
.ru-t1 {
  font-size: 25rpx; font-weight: 600; letter-spacing: -.3rpx;
  line-height: 1.6; margin-top: 12rpx; color: #242E2B;
}
.ru-m1 { font-size: 22rpx; color: #69736D; margin-top: 10rpx; }
.ru-chev { width: 30rpx; height: 30rpx; opacity: .5; flex: none; }

.ru-empty {
  padding: 30rpx 24rpx; background: #FFFDF9;
  border: 1rpx solid #E5E7E0; border-radius: 24rpx;
  font-size: 24rpx; color: #69736D;
}
.ru-toggle {
  color: #226B60; font-size: 24rpx;
  padding: 20rpx 4rpx 8rpx; min-height: 88rpx;
  display: flex; align-items: center;
}
