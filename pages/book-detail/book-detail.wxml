<view class="bd-page">
  <block wx:if="{{book}}">
    <!-- 书封大卡 -->
    <view class="hero-card">
      <image class="hero-cover" src="{{book.cover}}" mode="aspectFill" />
      <view class="hero-info">
        <view class="hero-title">{{book.title}}</view>
        <view class="hero-desc">
          <text class="hero-desc-line">{{book.author}}</text>
          <text class="hero-desc-line">{{book.descLine2}}</text>
        </view>
        <view class="hero-badges">
          <text class="cbadge" style="border-color:{{heroAccent}};color:{{heroAccent}};">{{book.stats.chapters}} 章 · {{book.stats.steps}} 条</text>
          <text class="cbadge" style="border-color:{{heroAccent}};color:{{heroAccent}};">更新 {{updatedLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 继续阅读 -->
    <view wx:if="{{readingSec}}" class="continue-card" bindtap="onContinue" hover-class="row-hover">
      继续阅读 · {{readingTitle}} ›
    </view>

    <!-- 统计三卡 -->
    <view class="bmeta">
      <view class="m"><view class="v">{{book.stats.steps}}</view><view class="k">建议条数</view></view>
      <view class="m"><view class="v">{{stat2}}</view><view class="k">{{stat2Label}}</view></view>
      <view class="m"><view class="v o">{{avgMin}} min</view><view class="k">平均条阅读</view></view>
    </view>

    <!-- 主题筛选 -->
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view class="chip {{filter === item.id ? 'on' : ''}}" wx:for="{{topics}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onFilter">
        {{item.name}}<text class="chip-cnt">{{item.count}}</text>
      </view>
    </scroll-view>

    <!-- 章节列表 -->
    <view class="chapters">
      <view class="chrow" wx:for="{{shownChapters}}" wx:key="uid"
            data-sec="{{item.sec}}" bindtap="onChapterTap" hover-class="row-hover">
        <text class="ch-no">{{item.sec}}</text>
        <text class="ch-title grow">{{item.title}}</text>
        <text wx:if="{{item.sec === readingSec}}" class="ch-reading">在读</text>
        <text class="ch-count">{{item.count}} 条</text>
      </view>
      <view wx:if="{{hasMore}}" class="chrow chrow-all" bindtap="onToggleAll" hover-class="row-hover">
        <text>全部 {{filteredCount}} 章 ›</text>
      </view>
      <view wx:elif="{{filteredCount > 8}}" class="chrow chrow-all" bindtap="onToggleAll" hover-class="row-hover">
        <text>收起 ›</text>
      </view>
    </view>

    <view class="source-card">
      <view>{{book.author}}</view>
      <view>{{book.license}}</view>
      <view class="source-link" bindtap="onCopySource">复制原作链接 ›</view>
    </view>
    <view class="lib-note">正文为原书结构编译，字段口径未逐条人工复核。</view>
  </block>

  <view wx:if="{{loadError}}" class="empty-card">
    <text>{{loadError}}</text>
    <view class="back-btn" bindtap="onOpenLibrary">返回知识库</view>
  </view>
</view>
