/* 主题聚合 · 与知识库 tab 同一套暖瓷白视觉 */
page { background: #F6F5F0; }
.ta-page { padding: 24rpx 36rpx 56rpx; box-sizing: border-box; }
.row-hover { opacity: .8; }

.topic-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #FFFDF9;
  border: 1rpx solid #E5E7E0;
  border-radius: 24rpx;
}
.topic-head-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 20rpx;
  background: #E5EEE7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.topic-head-ico image { width: 40rpx; height: 40rpx; }
.topic-head-txt { flex: 1; min-width: 0; }
.topic-head-name { font-size: 32rpx; font-weight: 700; color: #242E2B; }
.topic-head-meta { font-size: 22rpx; color: #727B75; margin-top: 6rpx; }
.topic-fav {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #727B75;
}
.topic-fav.on { color: #B8791A; }

.chips { white-space: nowrap; margin: 28rpx 0 20rpx; width: 100%; }
.chip {
  display: inline-block;
  font-size: 23rpx;
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E5E7E0;
  background: #FFFDF9;
  color: #69736D;
}
.chip.on { background: #E5EEE7; border-color: #226B60; color: #226B60; font-weight: 700; }

.minor {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  background: #FFFDF9;
  border: 1rpx solid #E5E7E0;
  border-radius: 24rpx;
}
.mdot { width: 10rpx; height: 46rpx; border-radius: 6rpx; flex: none; }
.mmain { flex: 1; min-width: 0; }
.mt { font-size: 27rpx; font-weight: 600; color: #242E2B; }
.mm { font-size: 21rpx; color: #727B75; margin-top: 6rpx; }
.chev { width: 28rpx; height: 28rpx; flex: none; opacity: .5; }

.ta-empty { padding: 90rpx 40rpx; text-align: center; color: #69736D; font-size: 26rpx; line-height: 2; }
.back-btn {
  margin: 32rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  background: #226B60;
  color: #FFFFFF;
  font-size: 27rpx;
}
.ta-more {
  padding: 28rpx;
  text-align: center;
  font-size: 23rpx;
  color: #226B60;
}
