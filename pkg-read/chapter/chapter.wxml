<view class="rd-page">
  <view wx:if="{{viewState === 'missing'}}" class="rd-empty">
    <text>没有找到这一章，请从知识库重新进入。</text>
    <view class="back-btn" bindtap="onOpenLibrary">返回知识库</view>
  </view>

  <block wx:if="{{viewState === 'ready'}}">
    <!-- 章头 -->
    <view class="rd-header">
      <view class="rd-topics" wx:if="{{topicTags.length}}">
        <text class="rd-topic" wx:for="{{topicTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="rd-title">{{chapter.title}}</view>
      <view class="rd-meta">{{bookTitle}} · 第 {{sec}} 章 · {{chapter.count}} 条建议 · 约 {{readMinutes}} 分钟{{updatedLabel ? ' · 更新 ' + updatedLabel : ''}}</view>
      <view class="rd-summary" wx:if="{{chapter.intro}}">{{chapter.intro}}</view>
    </view>

    <!-- 条目 -->
    <view class="rd-step" wx:for="{{list}}" wx:key="id">
      <view class="s-no">NO.{{item.noLabel}}</view>
      <view class="s-title">{{item.title}}</view>
      <view class="s-plain" wx:if="{{item.plain}}">{{item.plain}}</view>
      <view class="s-tip" wx:if="{{item.tip}}"><text class="s-tip-k">怎么说</text>{{item.tip}}</view>

      <view class="s-chips" wx:if="{{item.grade || item.lensText || item.costTags.length || item.dispute}}">
        <text class="s-chip" wx:if="{{item.grade}}">{{item.grade}}</text>
        <text class="s-chip dim" wx:if="{{item.lensText}}">{{item.lensText}}</text>
        <text class="s-chip dim" wx:for="{{item.costTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        <text class="s-chip dim" wx:if="{{item.dispute}}">争议</text>
      </view>

      <view class="s-folds">
        <block wx:if="{{item.costText}}">
          <view class="fold {{item.costOpen ? '' : 'closed'}}" data-idx="{{index}}" data-field="costOpen" catchtap="onToggleFold">成本<text class="fv">▾</text></view>
          <view class="fold-body" wx:if="{{item.costOpen}}">{{item.costText}}</view>
        </block>
        <block wx:if="{{item.gainText}}">
          <view class="fold {{item.gainOpen ? '' : 'closed'}}" data-idx="{{index}}" data-field="gainOpen" catchtap="onToggleFold">收益<text class="fv">▾</text></view>
          <view class="fold-body" wx:if="{{item.gainOpen}}">{{item.gainText}}</view>
        </block>
        <block wx:if="{{item.remark}}">
          <view class="fold {{item.noteOpen ? '' : 'closed'}}" data-idx="{{index}}" data-field="noteOpen" catchtap="onToggleFold">备注<text class="fv">▾</text></view>
          <view class="fold-body" wx:if="{{item.noteOpen}}">{{item.remark}}</view>
        </block>
        <block wx:if="{{item.refCount > 0}}">
          <view class="fold {{item.refsOpen ? '' : 'closed'}}" data-idx="{{index}}" data-field="refsOpen" catchtap="onToggleFold">来源<text class="fold-cnt"> · {{item.refCount}} 条</text><text class="fv">▾</text></view>
          <view class="src-body" wx:if="{{item.refsOpen}}">
            <view class="src-line" wx:for="{{item.refList}}" wx:for-item="ref" wx:key="no">
              <text class="src-idx">[{{ref.no}}]</text>
              <view class="src-txt">
                <block wx:for="{{ref.runs}}" wx:for-item="run" wx:key="index">
                  <text wx:if="{{run.url}}" class="src-url" data-url="{{run.t}}" catchtap="onCopyRefUrl">{{run.t}}</text>
                  <text wx:else>{{run.t}}</text>
                </block>
                <text class="src-extra" wx:if="{{ref.extra}}">原文节选外 · 全量抽取</text>
              </view>
            </view>
            <view class="s-ev" wx:if="{{item.evType}}">证据类型：{{item.evType}}</view>
          </view>
        </block>
      </view>

      <!-- 条目操作：查看详情 / 收藏本条 / 分享本条（与指南库一致，右对齐） -->
      <view class="s-acts">
        <text class="s-link" data-id="{{item.id}}" catchtap="onItemTap">查看条目详情 ›</text>
        <view class="s-acts-right">
          <view class="s-act" hover-class="s-act-hover" catchtap="onStepFavorite" data-idx="{{index}}">
            <text class="s-act-ico {{item.fav ? 'on' : ''}}">{{item.fav ? '★' : '☆'}}</text>
            <text>{{item.fav ? '已收藏' : '收藏'}}</text>
          </view>
          <button class="s-act s-share-btn" open-type="share" data-id="{{item.id}}" hover-class="s-act-hover">
            <text class="s-act-ico">↗</text>
            <text>分享</text>
          </button>
        </view>
      </view>
    </view>

    <view class="rd-more" wx:if="{{hasMore}}" bindtap="loadMore">已显示 {{shownCount}} / {{chapter.count}} 条 · 点击加载更多</view>
    <view class="rd-more" wx:else>本章已全部显示</view>

    <!-- 翻章 -->
    <view class="rd-nav">
      <view class="rd-nav-btn {{prevSec ? '' : 'off'}}" data-sec="{{prevSec}}" bindtap="onChapterNav">‹ 上一章</view>
      <view class="rd-nav-btn {{nextSec ? '' : 'off'}}" data-sec="{{nextSec}}" bindtap="onChapterNav">下一章 ›</view>
    </view>

    <!-- 底部操作栏：收藏 / 点赞 / 转发好友 / 朋友圈（与指南库一致） -->
    <view class="rd-footer">
      <view class="rb" data-act="fav" bindtap="onChapterFavorite" hover-class="rb-hover">
        <text class="rb-ico {{isChapterFav ? 'hot' : ''}}">{{isChapterFav ? '★' : '☆'}}</text>
        <text class="rb-t {{isChapterFav ? 'hot' : ''}}">{{isChapterFav ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="rb" data-act="like" bindtap="onLike" hover-class="rb-hover">
        <text class="rb-ico {{isLiked ? 'hot' : ''}}">{{isLiked ? '♥' : '♡'}}</text>
        <text class="rb-t">点赞</text>
      </view>
      <button class="rb" open-type="share" hover-class="rb-hover">
        <text class="rb-ico">↗</text>
        <text class="rb-t">转发好友</text>
      </button>
      <view class="rb" data-act="timeline" bindtap="onTimelineGuide" hover-class="rb-hover">
        <text class="rb-ico">◎</text>
        <text class="rb-t">朋友圈</text>
      </view>
    </view>

    <view class="like-burst" wx:if="{{burstShow}}"><text class="like-heart">♥</text></view>
  </block>
</view>
